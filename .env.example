# Copy this file to ".env" and fill in your credentials.
# The .env file is gitignored — never commit real secrets.

# HuggingFace token — REQUIRED for MedGemma (the model is gated).
# 1. Create a token at https://huggingface.co/settings/tokens
# 2. Accept the license at https://huggingface.co/google/medgemma-4b-it
HF_TOKEN=

# Google Gemini API key — used ONLY for offline QA-dataset generation.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kaggle credentials — used by scripts/download_data.py.
# Found in kaggle.json (https://www.kaggle.com/settings -> Create New Token).
KAGGLE_USERNAME=
KAGGLE_KEY=
